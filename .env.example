# ---------------------------------------------------------------
# GoHighLevel — Private Integration Token (API v2)
# Settings → Integrations → Private Integrations → Create
# Scopes needed: contacts.write, contacts.readonly, opportunities.write,
#                calendars.readonly, calendars/events.write, locations.readonly
# ---------------------------------------------------------------
GHL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sub-account (location) ID — Settings → Business Profile
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Calendar used for strategy call bookings — Calendars → settings → copy ID
GHL_CALENDAR_ID=xxxxxxxxxxxxxxxxxxxx

# Optional: auto-create a pipeline deal per lead.
# Opportunities → Pipelines → copy the pipeline + first-stage IDs.
# Leave blank to skip deal creation (leads still land as contacts).
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Shared secret for inbound webhooks (Settings → Webhooks)
GHL_WEBHOOK_SECRET=


# ---------------------------------------------------------------
# Sanity CMS — embedded directly in this app, no separate project needed.
# Visit /studio once these are set and `npm run dev` is running.
# Get project ID + dataset from https://sanity.io/manage (create a free
# project there first — "Clean project" template, no need to init a CLI
# project locally, this app IS the Studio).
# ---------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Read-only API token: sanity.io/manage -> your project -> API -> Tokens
# -> Add API token -> "Viewer" permissions. Used server-side only, for
# the public site's data fetching (NOT for Studio login, which uses your
# own Sanity account via OAuth in the browser).
SANITY_API_TOKEN=sk_your_read_only_token
SANITY_WEBHOOK_SECRET=your_random_secret_here

# Public site URL, used for canonical + OG tags
NEXT_PUBLIC_SITE_URL=https://peakhawks.com
